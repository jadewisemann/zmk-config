if ZMK_SPLIT && ZMK_SPLIT_ESB

menu "ESB Transport"

config ZMK_SPLIT_ESB_ROLE_CENTRAL
    bool
    default y if ZMK_SPLIT_ROLE_CENTRAL
    select ZMK_ESB_CENTRAL

config ZMK_SPLIT_ESB_PRIORITY
    int "ESB transport priority"
    default 1
    help
        Lower number priority transports are favored over higher numbers.
        ZMK_SPLIT_TRANSPORT_{CENTRAL,PERIPHERAL}_REGISTER already referenced
        this symbol; without a definition the registration section was named
        after the literal macro text rather than a priority.

endmenu

config ZMK_SPLIT_ESB_PERIPHERAL_ID
    int "Default peripheral id for TX"
    default 0

config ZMK_SPLIT_ESB_BITRATE_2MBPS
    bool "Set ESB bitrate to 2Mbps"
    default y

config ZMK_SPLIT_ESB_USE_WORK_QUEUE_DEDICATED
    bool "use dedicated workqueue for esb thread"
    default n

config ZMK_SPLIT_ESB_RX_THREAD_STACK_SIZE
    int "esb rx thread stack size"
    default 2048

config ZMK_SPLIT_ESB_RX_THREAD_PRIORITY
    int "esb rx thread priority"
    default -1

config ZMK_SPLIT_ESB_SEND_WHOLE_KEY
    bool "send whole key state"
    default n

config ZMK_SPLIT_ESB_PACED_SOURCE
    int "Half whose key events the central passes on in a fixed rhythm (-1: none)"
    depends on ZMK_SPLIT_ESB_ROLE_CENTRAL && ZMK_SPLIT_ESB_SEND_WHOLE_KEY
    default -1
    help
        Makes the timing between the two halves what it is over Bluetooth.

        With a Bluetooth split, the half that is the central handles its own
        keys at once, while the other half's keys wait for the next connection
        event, which comes every 7.5 ms. Over ESB both halves arrive within a
        millisecond or three. That is faster, but it moves the point at which
        a hold-tap on one half and a key on the other count as "released
        first": a thumb released up to ~7 ms after a key of the other hand
        was a tap over Bluetooth and is a hold over ESB, and typing habits are
        tuned to the former.

        With this set to a half's peripheral id (0: left, 1: right), the
        central passes that half's key events on only at multiples of
        ZMK_SPLIT_ESB_PACED_INTERVAL_US, like a connection event would. Set it
        to the half that is not the central in the Bluetooth mode the keymap
        was tuned in. It adds up to one interval of latency to that half.

config ZMK_SPLIT_ESB_PACED_INTERVAL_US
    int "Rhythm of the paced half, in microseconds"
    depends on ZMK_SPLIT_ESB_PACED_SOURCE >= 0
    default 7500
    help
        7500 is the connection interval ZMK uses between the halves.

config ZMK_SPLIT_ESB_LINK_STATS
    bool "Log link statistics once per second"
    depends on ZMK_SPLIT_ESB_ROLE_CENTRAL
    help
        The central logs, for every half, how the link did in the last second
        (answers, retries, lost sync, signal strength, and how long the half's
        key events waited before they were acknowledged) and every key event
        as it arrives. Needs a log backend, e.g. the zmk-usb-logging snippet.
        See the module README for how to read the lines.

module = ZMK_SPLIT_ESB
module-str = ZMK_SPLIT_ESB
source "${ZEPHYR_BASE}/subsys/logging/Kconfig.template.log_config"

endif #ZMK_SPLIT && ZMK_SPLIT_ESB

# **************************************************************************
# Following config is cloned for battery monitoring, if BLE is not enabled.
# **************************************************************************

if ZMK_SPLIT && !ZMK_SPLIT_BLE
if ZMK_SPLIT_ROLE_CENTRAL

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    int "Number of peripherals that will connect to the central."

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING
    bool "Fetch Peripheral Battery Level Info"

if ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_QUEUE_SIZE
    int "Max number of battery level events to queue when received from peripherals"
    default ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS

config ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY
    bool "Proxy Peripheral Battery Level Info"

endif #ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING

endif #ZMK_SPLIT_ROLE_CENTRAL
endif #ZMK_SPLIT && !ZMK_SPLIT_BLE
