config ZMK_ESB_SYS_TIMER_INSTANCE
	int
	default 0 if ZMK_ESB_SYS_TIMER0
	default 1 if ZMK_ESB_SYS_TIMER1
	default 2 if ZMK_ESB_SYS_TIMER2
	default 3 if ZMK_ESB_SYS_TIMER3
	default 4 if ZMK_ESB_SYS_TIMER4
	default 10 if ZMK_ESB_SYS_TIMER10
	default 20 if ZMK_ESB_SYS_TIMER020
	default 21 if ZMK_ESB_SYS_TIMER021
	default 22 if ZMK_ESB_SYS_TIMER022

config ZMK_ESB_SYS_TIMER_INSTANCE_LEADING_ZERO
	bool
	default y if ZMK_ESB_SYS_TIMER020 || ZMK_ESB_SYS_TIMER021 || ZMK_ESB_SYS_TIMER022

choice ZMK_ESB_SYS_RTC
	default ZMK_ESB_SYS_RTC2 if $(dt_nodelabel_has_compat,rtc2,$(DT_COMPAT_NORDIC_NRF_RTC))
	default ZMK_ESB_SYS_RTC0
	prompt "RTC to use for the ESB system RTC"

