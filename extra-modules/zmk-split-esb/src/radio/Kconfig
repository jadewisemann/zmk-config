# Radio layer options. Sourced from the module Kconfig inside "if ZMK_SPLIT_ESB".

config ZMK_ESB_CENTRAL
	bool "esb tdma central config"
	default n

config ZMK_ESB_MAX_PAYLOAD_LENGTH
	int "Maximum payload size"
	default 20
	range 1 252
	help
	  The maximum size of the payload.

config ZMK_ESB_RX_FIFO_SIZE
	int "RX buffer length"
	default 8
	help
	  The length of the RX FIFO buffer, in number of elements.

config ZMK_ESB_PIPE_COUNT
	int "Maximum number of pipes"
	default 8
	range 1 8
	help
	  The maximum number of pipes allowed in the API. Can be used if you
	  need to restrict the number of pipes used. The purpose is to prevent
	  accidental use of additional pipes, but it's not a problem leaving
	  this at 8 even if fewer pipes are used.

config ZMK_ESB_RADIO_IRQ_PRIORITY
	int "Radio interrupt priority"
	range 0 5 if ZERO_LATENCY_IRQS
	range 0 6
	default 1

config ZMK_ESB_EVENT_IRQ_PRIORITY
	int "Event interrupt priority"
	range 0 5 if ZERO_LATENCY_IRQS
	range 0 6
	default 2

config ZMK_ESB_SIM_ISR_LATENCY_US
	int "Simulated interrupt latency (tests/esb only)"
	depends on ARCH_POSIX
	default 0
	help
	  On the simulated board code runs in zero time, so an interrupt handler
	  reacts in the same microsecond the interrupt is raised. A real CPU
	  needs some tens of microseconds to get there and through the handler.
	  This makes every radio-layer interrupt handler start that much later,
	  so the tests also cover the time the handlers have.

config ZMK_ESB_TX_RINGBUF_SIZE
	int "set tx ringbuf size"
	default 256

config ZMK_ESB_WHITEEN
	bool "enable data whitening"
	default y

choice ZMK_ESB_POLLING_RATE_SEL
    prompt "Polling rate"
    default ZMK_ESB_POLLING_RATE_1KHZ

config ZMK_ESB_POLLING_RATE_2KHZ
    bool "2000 Hz"

config ZMK_ESB_POLLING_RATE_1KHZ
    bool "1000 Hz"

config ZMK_ESB_POLLING_RATE_500HZ
    bool "500 Hz"

config ZMK_ESB_POLLING_RATE_250HZ
    bool "250 Hz"

config ZMK_ESB_POLLING_RATE_125HZ
    bool "125 Hz"

endchoice

config ZMK_ESB_POLLING_RATE
    int
    default 2000 if ZMK_ESB_POLLING_RATE_2KHZ
    default 1000 if ZMK_ESB_POLLING_RATE_1KHZ
    default 500  if ZMK_ESB_POLLING_RATE_500HZ
    default 250  if ZMK_ESB_POLLING_RATE_250HZ
    default 125  if ZMK_ESB_POLLING_RATE_125HZ

menu "Hardware selection (alter with care)"

choice ZMK_ESB_SYS_TIMER
	default ZMK_ESB_SYS_TIMER021 if $(dt_nodelabel_has_compat,timer021,$(DT_COMPAT_NORDIC_NRF_TIMER))
	default ZMK_ESB_SYS_TIMER10 if $(dt_nodelabel_has_compat,timer10,$(DT_COMPAT_NORDIC_NRF_TIMER))
	default ZMK_ESB_SYS_TIMER2
	prompt "Timer to use for the ESB system timer"

